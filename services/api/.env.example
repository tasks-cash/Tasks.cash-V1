# Copy to services/api/.env — values must match monorepo root .env
APP_URL=http://localhost:4000
API_URL=http://localhost:4000
PORT=4000

JWT_SECRET=change-me-to-match-root-env
JWT_EXPIRES_IN=7d

NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHALLENGE_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tasks_cash

# Redis
REDIS_URL=redis://localhost:6380
REDIS_DB=0
# In Docker Compose, api overrides REDIS_URL with redis://redis:6379

# Complete-page content cache
PAGE_CONTENT_CACHE_TTL_SECONDS=300
PAGE_CONTENT_CACHE_STALE_SECONDS=900
PAGE_CONTENT_CACHE_LOCK_TTL_MS=5000
PAGE_CONTENT_CACHE_SCHEMA_VERSION=v1
PAGE_CONTENT_CACHE_TENANT=public
