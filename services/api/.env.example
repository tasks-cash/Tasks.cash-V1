# Copy to services/api/.env — values must match monorepo root .env
APP_URL=http://localhost:4000
API_URL=http://localhost:4000
PORT=4000

JWT_SECRET=change-me-to-match-root-env
JWT_EXPIRES_IN=7d

NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHALLENGE_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tasks_cash

# Redis
REDIS_URL=redis://localhost:6380
# In Docker Compose, api/worker override this with redis://redis:6379
