{
  "name": "@tasks-cash/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "seed:content": "tsx src/seedContent.ts",
    "cms:sync": "tsx src/cmsSync.ts",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "node --import tsx --test test/cache/**/*.test.ts test/domain/**/*.test.ts test/observability/**/*.test.ts test/jobs/**/*.test.ts test/campaignIntelligence/**/*.test.ts test/miraaj/**/*.test.ts",
    "test:miraaj": "node --import tsx --test test/miraaj/**/*.test.ts",
    "test:campaign-intelligence": "node --import tsx --test test/campaignIntelligence/**/*.test.ts",
    "test:cache": "node --import tsx --test test/cache/**/*.test.ts",
    "test:domain": "node --import tsx --test test/domain/**/*.test.ts",
    "test:observability": "node --import tsx --test test/observability/**/*.test.ts"
  },
  "dependencies": {
    "@tasks-cash/game-engine": "workspace:*",
    "@tasks-cash/types": "workspace:*",
    "@tasks-cash/utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
