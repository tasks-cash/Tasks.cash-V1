# ─── App ───────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000
CHALLENGE_APP_URL=http://localhost:3001

# ─── MongoDB ───────────────────────────────────────────
# Docker (with auth): mongodb://tasks_cash:tasks_cash_secret@localhost:27017/tasks_cash?authSource=admin
# Local/simple:       mongodb://127.0.0.1:27017/tasks_cash
MONGODB_URI=mongodb://127.0.0.1:27017/tasks_cash

# ─── Redis ─────────────────────────────────────────────
# Local dev (API run on host): start Redis via Docker first → redis://localhost:6380
# Docker Compose (api/worker containers): uses redis://redis:6379 (set in docker-compose.yml)
REDIS_URL=redis://localhost:6380

# ─── Auth ──────────────────────────────────────────────
# JWT_SECRET must match across root .env, apps/web/.env.local, apps/admin/.env.local, challenge .env.local
JWT_SECRET=vfUNSf1J7NIEt5AFbNpMHS5qr0D0yX99RVOs4VFqzmBNKdPYpk1mLOeeiV7mcl0HBXsbEY8DjTpA/0cM4shmow==
JWT_EXPIRES_IN=7d
# Production cookie domain for tasks.cash + challenge.tasks.cash
# AUTH_COOKIE_DOMAIN=.tasks.cash

# ─── Game Engine ───────────────────────────────────────
XP_PER_LEVEL=1000
COIN_MULTIPLIER=1.0
REFERRAL_BONUS_COINS=50
DAILY_BONUS_COINS=25
LEADERBOARD_CACHE_TTL=300

# ─── Notifications ─────────────────────────────────────
NOTIFICATION_RETENTION_DAYS=30

# ─── Ports ─────────────────────────────────────────────
WEB_PORT=3000
ADMIN_PORT=3002
API_PORT=4000
PORT=4000
WORKER_PORT=4001

# ─── Next.js public URLs (required — copy to each frontend app .env.local) ──
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHALLENGE_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=Tasks.cash
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_MYSTERY_CHALLENGES_URL=http://localhost:3001

# Production:
# APP_URL=https://tasks.cash
# ADMIN_URL=https://admin.tasks.cash
# API_URL=https://tasks.cash/api
# CHALLENGE_APP_URL=https://challenge.tasks.cash
# NEXT_PUBLIC_MAIN_APP_URL=https://tasks.cash
# NEXT_PUBLIC_API_URL=https://tasks.cash/api
# NEXT_PUBLIC_CHALLENGE_APP_URL=https://challenge.tasks.cash
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.tasks.cash
