# ─── App ───────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:4000
ADMIN_URL=http://localhost:3002
API_URL=http://api:4000
CHALLENGE_APP_URL=http://localhost:3001

# ─── MongoDB ───────────────────────────────────────────
# Docker (with auth): mongodb://tasks_cash:tasks_cash_secret@localhost:27017/tasks_cash?authSource=admin
# Local/simple:       mongodb://127.0.0.1:27017/tasks_cash
MONGODB_URI=mongodb://127.0.0.1:27017/tasks_cash

# ─── Redis ─────────────────────────────────────────────
# Local dev (API run on host): start Redis via Docker first → redis://localhost:6380
# Docker Compose (api containers): uses redis://redis:6379 (internal port 6379)
REDIS_URL=redis://localhost:6380
# Logical Redis DB index (default 0). Do not share with unrelated projects.
REDIS_DB=0

# Complete-page content cache (see docs/PAGE_CONTENT_CACHE.md)
PAGE_CONTENT_CACHE_ENABLED=true
PAGE_CONTENT_CACHE_VERSION=v1
PAGE_CONTENT_CACHE_SCHEMA_VERSION=v1
PAGE_CONTENT_CACHE_TENANT=public
PAGE_CONTENT_CACHE_TTL_SECONDS=300
PAGE_CONTENT_CACHE_STALE_SECONDS=900
PAGE_CONTENT_CACHE_LOCK_TTL_MS=15000
PAGE_CONTENT_CACHE_LOCK_WAIT_MS=5000
PAGE_CONTENT_CACHE_LOCK_RETRY_MS=100
# Dev: headers/logs on by default when NODE_ENV!=production
PAGE_CONTENT_CACHE_DEBUG_HEADERS=false
# PAGE_CONTENT_CACHE_DEBUG_LOGS=true

# Observability — see docs/OBSERVABILITY.md
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=logs
LOG_RETENTION_DAYS=14
PERF_HTTP_SLOW_MS=1000
PERF_MONGO_SLOW_MS=500
PERF_REDIS_SLOW_MS=200
PERF_SERVICE_SLOW_MS=800
# PAGE_CONTENT_CACHE_SWR=false
# Legacy alias still accepted:
CONTENT_CACHE_TTL_SECONDS=300

# Campaign Intelligence (Phase 8)
CAMPAIGN_INTELLIGENCE_ENABLED=true
# Tests force the fake provider internally; every non-test runtime rejects it.
CAMPAIGN_AI_PROVIDER=none
CAMPAIGN_CACHE_TTL_SECONDS=300
# Production provider credentials belong only in the runtime secret store.
CAMPAIGN_OPENAI_API_KEY=
CAMPAIGN_OPENAI_BASE_URL=https://api.openai.com/v1
CAMPAIGN_OPENAI_MODEL=gpt-4.1-mini
CAMPAIGN_PROVIDER_TIMEOUT_MS=90000

# ─── Auth ──────────────────────────────────────────────
# JWT_SECRET must match across root .env, apps/web/.env.local, apps/admin/.env.local, challenge .env.local
JWT_SECRET=vfUNSf1J7NIEt5AFbNpMHS5qr0D0yX99RVOs4VFqzmBNKdPYpk1mLOeeiV7mcl0HBXsbEY8DjTpA/0cM4shmow==
JWT_EXPIRES_IN=7d
# Local Docker / dev — leave empty so cookies work on localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
# Production cookie domain for tasks.cash + challenge.tasks.cash
# AUTH_COOKIE_DOMAIN=.tasks.cash
# COOKIE_SECURE=true

# ─── Game Engine ───────────────────────────────────────
XP_PER_LEVEL=1000
COIN_MULTIPLIER=1.0
REFERRAL_BONUS_COINS=50
DAILY_BONUS_COINS=25
LEADERBOARD_CACHE_TTL=300

# ─── Notifications ─────────────────────────────────────
NOTIFICATION_RETENTION_DAYS=30

# ─── Ports ─────────────────────────────────────────────
WEB_PORT=3000
ADMIN_PORT=3002
API_PORT=4000
PORT=4000
WORKER_PORT=4001

# ─── Next.js public URLs (required — copy to each frontend app .env.local) ──
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHALLENGE_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=Tasks.cash
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_MYSTERY_CHALLENGES_URL=http://localhost:3001

# Production:
# APP_URL=https://tasks.cash
# ADMIN_URL=https://admin.tasks.cash
# API_URL=https://tasks.cash/api
# CHALLENGE_APP_URL=https://challenge.tasks.cash
# NEXT_PUBLIC_MAIN_APP_URL=https://tasks.cash
# NEXT_PUBLIC_API_URL=https://tasks.cash/api
# NEXT_PUBLIC_CHALLENGE_APP_URL=https://challenge.tasks.cash
# NEXT_PUBLIC_ADMIN_APP_URL=https://admin.tasks.cash
