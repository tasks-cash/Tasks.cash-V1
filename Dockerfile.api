FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
RUN pnpm config set fetch-retries 5 \
  && pnpm config set fetch-retry-mintimeout 10000 \
  && pnpm config set fetch-retry-maxtimeout 120000 \
  && pnpm config set registry https://registry.npmmirror.com
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY services/game-engine/package.json ./services/game-engine/
COPY services/api/package.json ./services/api/
RUN pnpm install --frozen-lockfile --filter @tasks-cash/api...

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/services ./services
COPY package.json pnpm-workspace.yaml .npmrc ./
COPY packages/ ./packages/
COPY services/api/ ./services/api/
COPY services/game-engine/ ./services/game-engine/

RUN pnpm --filter @tasks-cash/types build \
  && pnpm --filter @tasks-cash/utils build \
  && pnpm --filter @tasks-cash/game-engine build \
  && pnpm --filter @tasks-cash/api build

# Node runtime requires compiled JS — workspace packages default to src/ for dev
RUN node -e "const fs=require('fs'); for (const p of ['packages/types/package.json','packages/utils/package.json','services/game-engine/package.json']) { const j=JSON.parse(fs.readFileSync(p,'utf8')); j.main='./dist/index.js'; j.types='./dist/index.d.ts'; fs.writeFileSync(p, JSON.stringify(j,null,2)); }"

FROM node:20-alpine AS runner
WORKDIR /app
# NODE_ENV set at runtime via docker-compose (development for local, production for deploy)

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 apiuser

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/services/api/dist ./services/api/dist
COPY --from=builder /app/services/api/package.json ./services/api/
COPY --from=builder /app/services/game-engine ./services/game-engine
COPY package.json pnpm-workspace.yaml ./

USER apiuser
EXPOSE 4000
ENV PORT=4000
CMD ["node", "services/api/dist/index.js"]
